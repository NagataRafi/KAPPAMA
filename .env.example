# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — WEBSITE KAPPAMA
# Salin berkas ini ke `.env` untuk pengembangan lokal.
# JANGAN PERNAH MENYIMPAN KUNCI ASLI DI REPOSITORI.
# ==============================================================================

# Database: Neon PostgreSQL
DATABASE_URL="postgresql://user:password@ep-sample-pooler.neon.tech/kappama?sslmode=require"

# Otentikasi: Clerk
VITE_CLERK_PUBLISHABLE_KEY="pk_test_sample"
CLERK_SECRET_KEY="sk_test_sample"

# Proteksi Bot: Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAAsample"
TURNSTILE_SECRET_KEY="0x4AAAAAAAsample"

# Media Storage: Cloudflare R2
R2_BUCKET_NAME="kappama-media"

# Layanan Email: Resend
RESEND_API_KEY="re_sample"
RESEND_FROM_EMAIL="KAPPAMA <no-reply@kappama.org>"
EMAIL_ENABLED="false"

# Bootstrap Super Admin Pertama
BOOTSTRAP_SUPER_ADMIN_EMAIL="admin@kappama.org"
