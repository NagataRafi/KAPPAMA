# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (FRONTEND) — WEBSITE KAPPAMA
# Salin berkas ini ke `.env` untuk konfigurasi klien/frontend Vite lokal.
# JANGAN PERNAH MENYIMPAN KUNCI RAHASIA (SECRET KEY) DI BERKAS INI.
# Seluruh variabel berawalan VITE_* akan terekspos ke bundle browser publik.
# ==============================================================================

# Database: Neon PostgreSQL (Dipakai oleh Drizzle Kit CLI lokal)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.neon.tech/kappama?sslmode=require"

# Otentikasi Klien: Clerk Publishable Key (Publik)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_sample"

# Proteksi Bot Klien: Cloudflare Turnstile Site Key (Publik)
# Untuk dev lokal, gunakan Always Passes Test Sitekey:
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
