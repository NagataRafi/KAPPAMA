# ==============================================================================
# PAGES FUNCTIONS ENVIRONMENT VARIABLES TEMPLATE (BACKEND) — WEBSITE KAPPAMA
# Salin berkas ini ke `.dev.vars` untuk backend Cloudflare Pages Functions lokal.
# JANGAN PERNAH MENYIMPAN KUNCI ASLI DI REPOSITORI.
# ==============================================================================

# Database: Neon PostgreSQL
DATABASE_URL="postgresql://user:password@ep-sample-pooler.neon.tech/kappama?sslmode=require"

# Otentikasi Server: Clerk
CLERK_SECRET_KEY="sk_test_sample"

# Proteksi Bot Server: Cloudflare Turnstile
# Untuk lokal dev, gunakan Always Passes Test Secret Key: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Cloudinary (StorageService)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Layanan Email: Resend
RESEND_API_KEY="re_sample"
RESEND_FROM_EMAIL="KAPPAMA <no-reply@kappama.org>"
EMAIL_ENABLED="false"

# Bootstrap Super Admin Pertama
BOOTSTRAP_SUPER_ADMIN_EMAIL="admin@kappama.org"
